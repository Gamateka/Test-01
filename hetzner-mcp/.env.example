# Copia questo file in .env e compila i valori.
#   cp .env.example .env && chmod 600 .env
#
# .env non va mai committato: contiene URL con eventuali token.

# ---------------------------------------------------------------------------
# URL degli endpoint MCP
# ---------------------------------------------------------------------------
# Dove trovarli:
#
# CANVA_MCP_URL
#   Canva pubblica un server MCP remoto ufficiale. L'URL esatto si legge da
#   claude.ai -> Impostazioni -> Connettori -> Canva, oppure dalla pagina
#   "Canva MCP server" della documentazione per sviluppatori Canva.
#   Non e' hardcodato qui apposta: un URL sbagliato produce un fallimento
#   silenzioso e difficile da diagnosticare.
#
# HIGGSFIELD_MCP_URL
#   Nel tuo account claude.ai "MCP Higgsfield" risulta un connettore
#   personalizzato, cioe' aggiunto manualmente con un URL scelto da te.
#   Lo ritrovi in claude.ai -> Impostazioni -> Connettori -> MCP Higgsfield.

CANVA_MCP_URL=
HIGGSFIELD_MCP_URL=

# ---------------------------------------------------------------------------
# Autenticazione (opzionale)
# ---------------------------------------------------------------------------
# Lascia vuoto se il server usa OAuth interattivo (vedi README, sezione
# "Autenticazione su una macchina headless").
# Compila se il server accetta un bearer token statico: in quel caso lo script
# passa l'header Authorization al posto del flusso OAuth.

CANVA_MCP_TOKEN=
HIGGSFIELD_MCP_TOKEN=

# ---------------------------------------------------------------------------
# Endpoint REST usati dall'applicazione (per il solo test di egress)
# ---------------------------------------------------------------------------
# Servono a 01-check-egress.sh per verificare che il server raggiunga i
# servizi. Sostituisci con gli endpoint che l'app chiama davvero: li trovi
# nella sua configurazione.

CANVA_API_URL=https://api.canva.com/rest/v1/users/me
HIGGSFIELD_API_URL=https://higgsfield.ai/

# Scope di installazione dei server MCP in Claude Code: local | project | user
MCP_SCOPE=user
